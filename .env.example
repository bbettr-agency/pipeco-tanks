# Pipeco Tanks — environment variables
#
# Quote-form webhook (SERVER-SIDE ONLY — never prefixed with NEXT_PUBLIC_).
# The /api/quote route forwards validated enquiries to this URL. The browser
# never sees or calls it. Until this is set, the quote form fails safe with a
# clear message (it does NOT fake success or drop enquiries).
#
# Set this in Vercel → Project → Settings → Environment Variables, and in a
# local .env.local file for development.
PIPECO_QUOTE_WEBHOOK_URL=
